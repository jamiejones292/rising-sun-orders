# Copy to .env for local development only. Never commit real values.
# On the live site these are set in Netlify: Project configuration -> Environment variables.

# Public (safe to expose in the browser). Filled in at the database stage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Netlify Functions). NEVER prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
